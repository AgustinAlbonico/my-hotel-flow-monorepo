# SonarQube Configuration
# =======================
# Add these variables to your .env file or CI/CD environment

# SonarQube Server URL
# Local development: http://localhost:9000
# SonarCloud: https://sonarcloud.io
SONAR_HOST_URL=http://localhost:9000

# SonarQube Authentication Token
# Generate at: SonarQube > My Account > Security > Generate Token
# For SonarCloud: https://sonarcloud.io/account/security
SONAR_TOKEN=your_sonar_token_here

# Optional: Organization key (required for SonarCloud)
# SONAR_ORGANIZATION=your_organization_key
